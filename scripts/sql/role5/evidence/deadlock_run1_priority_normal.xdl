    BEGIN TRANSACTION;
        UPDATE dbo.Patients
        SET DiagnosisStatus = 'Under Review'
        WHERE PatientID = '0001';
        EXEC dbo.usp_Role5_Log N'A: X lock on Patients(0001) acquired';

        -- &gt;&gt;&gt; Switch to Session B (01_deadlock_B.sql) and press F5 &lt;&lt;&lt;
