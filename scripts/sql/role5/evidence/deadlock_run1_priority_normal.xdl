SET NOCOUNT ON;
SET DEADLOCK_PRIORITY NORMAL;

BEGIN TRY
    BEGIN TRANSACTION;
        UPDATE dbo.MRI_Scans
        SET AcquisitionDate = SYSDATETIME()
        WHERE ScanID = 1;
        EXEC dbo.usp_Role5_Log N'B: X lock on MRI_Scans(ScanID = 1) acquired';

        WAITFOR DELAY '00:00:02';

        EXEC dbo.usp_Role5_Log N'B: requesting X lock on Patients(0001) ...';
        UPDATE dbo.Patients
        SET DiagnosisStatus = 'Image Checked'
        WHERE PatientID = '0001';
    COMMIT TRANSACTION;
    EXEC dbo.usp_Role5_Log N'B: COMMIT - survived';
    SELECT 'B' AS Session, 'COMMITTED (survivor)' AS Outcome;
END TRY
BEGIN CATCH
    IF @@TRANCOUNT &gt; 0 ROLLBACK TRANSACTION;
    EXEC dbo.usp_Role5_Log N'B: chosen as deadlock victim - rolled back';
    SELECT 'B' AS Session, 'ROLLED BACK (deadlock victim)' AS Outcome,
           ERROR_NUMBER() AS ErrorNumber, ERROR_MESSAGE() AS ErrorMessage;
END CATCH
   </inputbuf></process><process id="process18a4ee74088" taskpriority="0" logused="308" waitresource="KEY: 6:72057594047299584 (8194443284a0)" waittime="1824" ownerId="426296" transactionname="user_transaction" lasttranstarted="2026-11-05T23:56:31.677" XDES="0x18a5051c480" lockMode="X" schedulerid="2" kpid="40976" status="suspended" spid="62" sbid="0" ecid="0" priority="0" trancount="2" lastbatchstarted="2026-11-05T23:56:31.673" lastbatchcompleted="2026-11-05T23:56:31.673" lastattention="1900-01-01T00:00:00.673" clientapp="SQLCMD" hostname="DESKTOP-GRL13Q5" hostpid="4280" loginname="DESKTOP-GRL13Q5\Thanh Phuong" isolationlevel="read committed (2)" xactid="426296" currentdb="6" currentdbname="SpineMRI_DBMS" lockTimeout="4294967295" clientoption1="673185824" clientoption2="128056"><executionStack><frame procname="adhoc" line="15" stmtstart="24" stmtend="184" sqlhandle="0x02000000abeb103a468ac159fb95e9cf1c92982f86ff4eb00000000000000000000000000000000000000000">
